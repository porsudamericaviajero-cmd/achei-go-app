VITE_SUPABASE_URL=https://seu-projeto.supabase.co
VITE_SUPABASE_ANON_KEY=sua-chave-anon-publica-do-supabase

# Chave de segurança rápida para acesso ao Painel Admin (/admin.html)
# Altere para uma senha forte de sua preferência
VITE_ADMIN_ACCESS_KEY=admin123456
